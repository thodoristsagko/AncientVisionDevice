# .env.example — AncientVision Docker environment variables
#
# Copy this file to .env and fill in values as needed.
# Lines starting with # are comments. Values shown are the defaults.

# ---------------------------------------------------------------------------
# docker-compose.collect.yml — Data Collection Service
# ---------------------------------------------------------------------------

# Where the collector writes CSVs and the .sample_count file.
DATA_DIR=/workspace/data

# Path to a GCP service account JSON on the HOST machine (bind-mounted into
# the container automatically when set). Leave empty to disable Firestore sync.
GOOGLE_APPLICATION_CREDENTIALS=

# Firestore collection name to poll for phone-uploaded vibration samples.
FIRESTORE_COLLECTION=vibration_samples

# ---------------------------------------------------------------------------
# docker-compose.train.yml — ML Retraining Pipeline
# ---------------------------------------------------------------------------

# Number of new samples that must accumulate before retraining is triggered.
TRIGGER_THRESHOLD=100

# Seconds between watcher polls (how often the watcher checks sample count).
POLL_INTERVAL=60

# ---------------------------------------------------------------------------
# .github/workflows — CI/CD Secrets (set in GitHub repo settings, NOT here)
# ---------------------------------------------------------------------------

# Firebase App ID used by fastlane / App Distribution upload.
# FIREBASE_APP_ID=

# Firebase CI token generated by `firebase login:ci`.
# FIREBASE_TOKEN=

# Base64-encoded google-services.json for Flutter build.
# GOOGLE_SERVICES_JSON=
